# Copiado a .env por Start-LocalAI.ps1. La clave se genera automaticamente.
# No publicar .env ni reutilizar la clave de otra instalacion.
WEBUI_SECRET_KEY=
WEBUI_PORT=3000

# Valores iniciales para RTX 5070 12 GB. Aumentar el contexto tras medir VRAM.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Solo se descarga PRIMARY_MODEL por defecto.
PRIMARY_MODEL=huihui_ai/qwen3.5-abliterated:9b
COMPARISON_MODEL=qwen3.5:9b
